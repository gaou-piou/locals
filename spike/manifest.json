{
  "manifest_version": 3,
  "name": "cdn-mirror spike",
  "version": "0.0.0",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "spike",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/*"
      ],
      "matches": [
        "*://*/*"
      ],
      "use_dynamic_url": false
    }
  ],
  "key": ""
}