# Maintainer: gaou-piou <i.am.piou@gmail.com>
pkgname=chromium-extension-locals
_pkgname=locals
pkgver=0.2.1
pkgrel=1
pkgdesc='λocals: Chromium extension that serves common CDN libraries from a local bundle (Decentraleyes/LocalCDN alike), loaded unpacked'
arch=('any')
depends=('bash' 'nodejs')
url='https://github.com/gaou-piou/locals'
# MPL-2.0 for the extension; the bundled libraries are MIT, and the font packages
# carry CC-BY-4.0 / OFL-1.1 (the licence text of each ships in libs/<name>/<version>/LICENSE).
license=('MPL-2.0' 'MIT' 'CC-BY-4.0' 'OFL-1.1')
install=locals.install
source=("$_pkgname-$pkgver.zip::$url/releases/download/v$pkgver/$_pkgname-$pkgver.zip"
        "locals-install"
        "locals-learn.cjs")
# Updated with every release: `sha256sum` of the CI-built zip (published as the .sha256 asset).
# The placeholder makes makepkg fail until it is replaced, so an unchecked download cannot be published by accident.
sha256sums=('REPLACE_WITH_RELEASE_SHA256'
            '702bfef3105aafef5d561b2cdf1b8e7c14182716e98c987fcf27a5fdc905901e'
            '3a2e53883b39dbdfab791b28b0086899e1852c22f552e920f67c9f7a17405ff4')

package() {
  install -d "$pkgdir/usr/share/$pkgname"
  cp -r "$srcdir/$_pkgname-$pkgver/." "$pkgdir/usr/share/$pkgname/"
  find "$pkgdir/usr/share/$pkgname" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/$pkgname" -type f -exec chmod 644 {} +
  install -Dm755 "$srcdir/locals-install" "$pkgdir/usr/bin/locals-install"
  install -Dm755 "$srcdir/locals-learn.cjs" "$pkgdir/usr/bin/locals-learn"
  install -Dm644 "$srcdir/$_pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # licence texts of the bundled libraries, one file per library version
  local lic
  for lic in "$srcdir/$_pkgname-$pkgver"/libs/*/*/LICENSE; do
    install -Dm644 "$lic" "$pkgdir/usr/share/licenses/$pkgname/libs/$(basename "$(dirname "$(dirname "$lic")")")-$(basename "$(dirname "$lic")")-LICENSE"
  done
}
