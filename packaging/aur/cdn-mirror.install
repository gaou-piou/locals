post_install() {
  cat <<MSG
==> cdn-mirror is an unpacked extension. Chromium writes into an unpacked extension's folder,
    so it cannot be loaded from the read-only /usr/share/cdn-mirror. Make a user copy first:
      1. run:  cdn-mirror-install        (prints the folder, ~/.local/share/cdn-mirror)
      2. open chrome://extensions (or brave://extensions) and turn on "Developer mode"
      3. "Load unpacked" and pick that folder
    After a package upgrade run  cdn-mirror-install  again and press reload on the extension card.
MSG
}

post_upgrade() {
  echo "==> cdn-mirror updated: run  cdn-mirror-install  and reload the extension on chrome://extensions."
}
