post_install() {
  cat <<MSG
==> cdn-mirror is an unpacked extension. To enable it:
      1. open chrome://extensions (or brave://extensions) and turn on "Developer mode"
      2. "Load unpacked" and pick:  /usr/share/cdn-mirror
    Browsers do not auto-update unpacked extensions: after a package upgrade, press the
    reload button on the extension card.
MSG
}

post_upgrade() {
  echo "==> cdn-mirror updated: reload it on chrome://extensions (or brave://extensions)."
}
